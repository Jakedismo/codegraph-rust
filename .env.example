# CodeGraph env example (copy to .env). Prefer env vars over committing secrets.
# Every variable here is read by the current code. Commented lines show defaults or examples.

# --- Embeddings ---
CODEGRAPH_EMBEDDING_PROVIDER=ollama          # ollama | openai | jina | lmstudio | onnx
CODEGRAPH_EMBEDDING_MODEL=qwen3-embedding:0.6b
CODEGRAPH_EMBEDDING_DIMENSION=1024
CODEGRAPH_EMBEDDINGS_BATCH_SIZE=64           # max texts per batch; --batch-size overrides this
# CODEGRAPH_EMBEDDING_BATCH_TOKENS=32768     # request budget; default >= model context (local floor 8192)
# CODEGRAPH_EMBEDDING_BATCH_BYTES=1048576    # 1 MiB default; independent of row limit
# CODEGRAPH_CHUNK_MAX_TOKENS=4096            # lower complete-input target, capped by serving context
# CODEGRAPH_CHUNK_SMART_SPLIT=1              # AST boundaries for oversized nodes (default)
# CODEGRAPH_CHUNK_OVERLAP_TOKENS=64          # token-counted overlap; 0 disables
# CODEGRAPH_EMBEDDING_SKIP_CHUNKING=0        # 1 keeps nodes intact and errors if oversized
# CODEGRAPH_OLLAMA_NUM_CTX=32768             # request context, capped by model maximum
# CODEGRAPH_TOKENIZER_PATH=/path/to/tokenizer.json # matching tokenizer for offline/custom use
# CODEGRAPH_TOKENIZER_REPO=Qwen/Qwen3-Embedding-0.6B # override automatic publisher mapping
# CODEGRAPH_TOKENIZER_REVISION=main          # pin tokenizer resource revision when needed
# CODEGRAPH_MODEL_MAX_TOKENS=32768           # missing metadata fallback or lower model cap
# CODEGRAPH_EMBEDDING_DOCUMENT_PREFIX=       # custom retrieval document prefix
# CODEGRAPH_EMBEDDING_QUERY_PREFIX=          # custom retrieval query prefix

# --- LLM (for the agentic tools; these override the [llm] section of the config file) ---
CODEGRAPH_LLM_PROVIDER=ollama                # ollama | openai | anthropic | openai-compatible | xai | lmstudio
CODEGRAPH_LLM_MODEL=qwen2.5-coder:14b        # then CODEGRAPH_AGENT_MODEL, CODEGRAPH_MODEL, [llm] model; else the provider default
CODEGRAPH_CONTEXT_WINDOW=32768               # your model's real token limit; selects the prompt tier
                                             # (<=50K small, <=150K medium, <=500K large, above massive)
# MCP_CODE_AGENT_MAX_OUTPUT_TOKENS=58000     # cap for final answers (Claude Code accepts ~64K)
# CODEGRAPH_TOOL_CONTENT_CHARS=2000          # snippet length for long content in tool results; 0 disables
# CODEGRAPH_AGENT_RESULT_BUDGET_BYTES=400000 # per-run tool-result budget; default ~1/3 of the window, 48-600 KB

# --- Agent ---
CODEGRAPH_AGENT_ARCHITECTURE=react           # react (default, alias: rig) | lats | reflexion
                                             # lats: tree search over reasoning steps; it does not call graph tools.
                                             # Tool-round budget follows the context tier: 3 / 5 / 6 / 8.

# --- Provider endpoints & keys ---
CODEGRAPH_OLLAMA_URL=http://localhost:11434
# CODEGRAPH_LMSTUDIO_URL=http://localhost:1234
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# JINA_API_KEY=...
# XAI_API_KEY=...
# OPENAI_API_BASE=https://api.openai.com/v1  # base URL for OpenAI embeddings
# CODEGRAPH_OPENAI_COMPATIBLE_URL=http://localhost:8000/v1 # agent LLM when CODEGRAPH_LLM_PROVIDER=openai-compatible
# OLLAMA_HOST=http://localhost:11434         # agent LLM Ollama endpoint (CODEGRAPH_OLLAMA_URL above is for embeddings)

# --- Database ---
# Nothing to configure by default: each project uses an embedded SurrealKV store at
# <project>/.codegraph/db, created with the bundled schema on first use.
# CODEGRAPH_SCHEMA=v1                        # new stores get schema/codegraph_v2.surql; v1 selects the original codegraph.surql
# Server mode (optional): set the URL to use a SurrealDB server instead, and apply the schema
# yourself with `cd schema && ./apply-schema.sh`.
# CODEGRAPH_SURREALDB_URL=ws://localhost:3004
# CODEGRAPH_SURREALDB_NAMESPACE=ouroboros
# CODEGRAPH_SURREALDB_DATABASE=codegraph
# CODEGRAPH_SURREALDB_USERNAME=root
# CODEGRAPH_SURREALDB_PASSWORD=root
# CODEGRAPH_SURREAL_POOL_SIZE=2              # server mode only: indexer connections (1-4)

# --- Project identity (optional) ---
# CODEGRAPH_PROJECT_ID=my-project            # defaults to the project path
# CODEGRAPH_ORGANIZATION_ID=my-org
# CODEGRAPH_REPOSITORY_URL=https://github.com/user/repo
# CODEGRAPH_DOMAIN=example.com

# --- Performance ---
CODEGRAPH_WORKERS=4                          # caps Rayon threads
# CODEGRAPH_SYMBOL_BATCH_SIZE=500
# CODEGRAPH_SYMBOL_MAX_CONCURRENT=4

# --- Server / daemon ---
CODEGRAPH_HTTP_HOST=127.0.0.1
CODEGRAPH_HTTP_PORT=3003
# CODEGRAPH_DAEMON_AUTO_START=true

# --- Logging ---
RUST_LOG=info

# --- Jina (when CODEGRAPH_EMBEDDING_PROVIDER=jina) ---
# JINA_API_BASE=https://api.jina.ai/v1
# Set CODEGRAPH_EMBEDDING_MODEL above to jina-embeddings-v4.
# JINA_API_TASK=code.passage
# JINA_LATE_CHUNKING=false                   # better embeddings with jina-embeddings-v4
# JINA_TRUNCATE=true
# JINA_MAX_TOKENS=256
# JINA_MAX_TEXTS=24
# JINA_REQUEST_DELAY_MS=100
# JINA_REL_BATCH_SIZE=50
# JINA_REL_MAX_TEXTS=50
# JINA_ENABLE_RERANKING=true
# JINA_RERANKING_MODEL=jina-reranker-v3
# JINA_RERANKING_TOP_N=10
# CODEGRAPH_RERANKING_CANDIDATES=256
